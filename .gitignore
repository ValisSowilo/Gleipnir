# This tree is a working directory as much as a source tree: it holds ~116
# development binaries, the benchmark corpora, and the scratch scripts from
# every A/B that did not become a decision.  Blacklisting that reliably is a
# losing game -- one forgotten `gen27.exe` and a 200 KB binary is in history
# forever.  So this file ignores everything and re-admits, by name, only what
# the README and ARCHITECTURE documents actually refer to.
#
# Adding a file to the repo therefore means adding a line here.  That is the
# point: it makes inclusion the deliberate act rather than exclusion.

*

# This file re-admits itself.  Without the line below `*` ignores .gitignore
# too, so it never gets committed and a fresh clone has no ignore rules -- the
# deny-all net that the rest of this file describes would exist only on the
# machine it was written on.
!.gitignore

# --- the compressor itself ------------------------------------------------
!gleipnir.c
!Makefile
!build.sh

# --- licence and documentation --------------------------------------------
!LICENSE.md
!COMMERCIAL.md
!SECURITY.md
!README.md
!USAGE.md
!ARCHITECTURE.md
!EXPERIENCES.md

# --- scripts, all under scripts/ ------------------------------------------
# The tooling that produced the numbers in the README lives here.  The
# directory has to be re-admitted before anything inside it can be, and then
# each script is admitted by name -- inclusion stays the deliberate act.
!scripts/

# the three verification gates: fuzz.py (container/deflate edge cases),
# tfuzz.py (round trips across thread counts), gfuzz.py (corruption).  CI runs
# the latter two on every push, from scripts/.
!scripts/fuzz.py
!scripts/tfuzz.py
!scripts/gfuzz.py

# standalone probes the docs cite as ground truth
!scripts/t_alpha.c
!scripts/t_seg.c
!scripts/t_period.c
!scripts/t_adiv.c

# support tools indexed in README "Repository layout"
!scripts/readblk.py
!scripts/cmp_gen.py
!scripts/full_ab.py
!scripts/final_bench.py
!scripts/bench_final.py
!scripts/make_mixed.py
!scripts/bench_mixed.py
!scripts/bench_refs.ps1
!scripts/byt_sweep.py
!scripts/t2_sweep.py
!scripts/ident_check.py
!scripts/ab_corpus.py
!scripts/f_ablate.py
!scripts/fshape.py
!scripts/ht_test.py
!scripts/ab_speedup.py
!scripts/e8.py
!scripts/e8_refs.py
!scripts/mkgraphs.py
!scripts/mkcorpora.py
!scripts/parse_bench_log.py
!scripts/sweep.py
!scripts/bench_session.py

# The measurement records behind the two preset tables in the README.
# bench_session.json is the single interleaved run the headline table and every
# cross-codec speed ratio are computed from; without it those numbers cannot be
# checked against anything.
!bench_final.json
!bench_session.json

# --- directories ----------------------------------------------------------
# A directory must be re-admitted before anything inside it can be.
!.github/
!.github/**
!graphs/
!graphs/*.svg
!packaging/
!packaging/**
!dist/
!dist/*

# Release binaries are attached to GitHub Releases, not committed.  Keeping
# them out means a clone stays under a megabyte and history does not grow by
# 2.5 MB with every point release.
dist/*.exe
dist/*.sha256

# --- never, under any circumstances ---------------------------------------
# tools/ holds upstream zlib plus the reference codecs used for benchmarking
# (zpaq, paq8px, lpaq1, 7zr) and the Silesia/enwik8 corpora: third-party code
# under other licences, and hundreds of megabytes.  build.sh expects the user
# to fetch and build zlib there themselves; it says so when libz.a is missing.
tools/
__pycache__/
*.pyc
gleipnir
gleipnir.exe
